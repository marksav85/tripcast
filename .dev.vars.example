# Local fixture mode needs no secrets. Leave this empty until live validation
# is separately authorized. Only the Worker may read this server-side name.
OPENWEATHER_API_KEY=

# Isolated Worker JWT verifier (local Supabase; no signing secrets).
# Cloud environments must explicitly configure their own confirmed issuer/JWKS.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256
# HTTP loopback is accepted only with STAGE=local (wrangler --env local).
