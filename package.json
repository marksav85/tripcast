{
  "name": "tripcast",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && oxlint --max-warnings 0",
    "test": "vitest",
    "test:run": "npm run test:client && npm run test:worker",
    "check": "npm run lint && npm run test:run && npm run build",
    "dev:worker": "wrangler dev --local --env local --port 8787",
    "preview:worker": "npm run build && npm run dev:worker",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "test:client": "vitest run",
    "db:reset": "node scripts/reset-local-db.mjs",
    "test:db": "node scripts/test-db-sql.mjs && node scripts/test-local-db.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@supabase/supabase-js": "2.117.3",
    "lottie-react": "^2.4.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.0.0",
    "jsdom": "30.1.2",
    "oxlint": "1.88.0",
    "postcss": "8.5.30",
    "supabase": "2.120.0",
    "tailwindcss": "3.4.19",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
