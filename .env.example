# Optional browser Auth; public weather works without these.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Obtain ONLY the local publishable key from private local CLI status output.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Put local values in gitignored .env.local. Never add privileged or weather keys.
# Production needs an explicitly reviewed HTTPS project origin and matching CSP.
