{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripcast",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "STAGE": "production",
    "MOCK_PROVIDER": "false",
    "SUPABASE_JWT_ISSUER": "https://oowesugpxxzvyvfqqxlu.supabase.co/auth/v1",
    "SUPABASE_JWKS_URL": "https://oowesugpxxzvyvfqqxlu.supabase.co/auth/v1/.well-known/jwks.json",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "SUPABASE_JWT_ALGORITHMS": "ES256"
  },
  "env": {
    "local": {
      "vars": {
        "STAGE": "local",
        "MOCK_PROVIDER": "true"
      }
    },
    "staging": {
      "vars": {
        "STAGE": "staging",
        "MOCK_PROVIDER": "false"
      }
    },
    "production": {
      "vars": {
        "STAGE": "production",
        "MOCK_PROVIDER": "false",
        "SUPABASE_JWT_ISSUER": "https://oowesugpxxzvyvfqqxlu.supabase.co/auth/v1",
        "SUPABASE_JWKS_URL": "https://oowesugpxxzvyvfqqxlu.supabase.co/auth/v1/.well-known/jwks.json",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "SUPABASE_JWT_ALGORITHMS": "ES256"
      },
      "routes": [
        {
          "pattern": "tripcast.marksavilledesigns.com",
          "custom_domain": true
        }
      ]
    }
  },
  "routes": [
    {
      "pattern": "tripcast.marksavilledesigns.com",
      "custom_domain": true
    }
  ]
}
