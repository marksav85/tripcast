{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripcast",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": { "STAGE": "production", "MOCK_PROVIDER": "false" },
  "env": {
    "local": { "vars": { "STAGE": "local", "MOCK_PROVIDER": "true" } },
    "staging": { "vars": { "STAGE": "staging", "MOCK_PROVIDER": "false" } },
    "production": { "vars": { "STAGE": "production", "MOCK_PROVIDER": "false" } }
  }
}
